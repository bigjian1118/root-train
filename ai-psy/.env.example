# ---------- 数据库 ----------
DATABASE_URL=postgresql+psycopg://psy:psy@127.0.0.1:5432/psy

# ---------- 主模型（vLLM / 远程兼容 API） ----------
# vllm | remote | mock；演示时切 remote 即可不启动本地 GPU 服务
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
LLM_MODEL=Qwen2.5-7B-Instruct
# vLLM --lora-modules 注册名，空串表示关闭 LoRA
LLM_LORA_NAME=psych-chat
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=2048

# 远程备选（OpenAI 兼容）；LLM_PROVIDER=remote 时生效。
# DeepSeek 示例（无 GPU 也可跑全部 AI 生成功能）：
#   REMOTE_BASE_URL=https://api.deepseek.com/v1
#   REMOTE_API_KEY=sk-你的密钥
#   REMOTE_MODEL=deepseek-chat
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_API_KEY=
REMOTE_MODEL=gpt-4o-mini

# ---------- 嵌入模型 BGE-M3（独立服务，不与 LLM 混用） ----------
# 本地 vLLM embedding 默认配置；无卡时可切线上 OpenAI 兼容嵌入（与 LLM 可不同供应商）：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-你的密钥
#   EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=BGE-M3
EMBEDDING_DIM=1024

# ---------- 无卡 + 线上模型 ----------
# start_all.sh 无卡探测默认置 AI_ENABLED=0（禁用 AI）；
# 切线上 API 时必须显式设为 1 放行：AI_ENABLED=1

# ---------- 其他 ----------
SECRET_KEY=change-me-in-production
# 视频表情分析网关（可选，独立部署的 py-feat 服务；未部署时该功能降级提示）
PYFEAT_GATEWAY_URL=http://127.0.0.1:8002
UPLOAD_DIR=/data/uploads
RAG_AUTO_INDEX=1
AGENT_MAX_TOOL_ROUNDS=4
BACKEND_URL=http://127.0.0.1:6006

# ---------- 注册账号自动分配 ----------
# 账号 = 前缀 + 纯数字随机串（首位非 0），全局唯一，冲突重试 5 次
ACCOUNT_PREFIX=
ACCOUNT_DIGITS=8

# ---------- 教师任教班级自主修改 ----------
# 单个教师可绑定的任教班级数量上限；0 表示不限制
MAX_TEACHER_CLASSES=0

# ---------- 账号注销（即时永久模式） ----------
# 无冷静期、不可撤销；身份校验使用登录密码（短信通道接入后自动升级）
